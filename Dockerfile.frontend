# =============================================================================
# SmartFirePredict — Frontend Nginx Dockerfile
# =============================================================================
# Serves the static dashboard (HTML/CSS/JS) via Nginx.
# The frontend makes API calls to the backend container (via JS fetch/XHR).
#
# Why Nginx and not Python/Flask?
#   - frontend/dashboard/server.py is an OLD Flask server kept for reference.
#     In the current architecture, FastAPI (backend) already serves the
#     frontend at "/" and "/static/...". This Nginx container is for the
#     full Docker Compose multi-container setup where frontend is isolated.
#   - Nginx: ~23 MB image, zero Python overhead, proper static asset caching,
#     gzip compression, and HTTP/2 support out of the box.
# =============================================================================

FROM nginx:1.27-alpine

LABEL maintainer="SmartFirePredict"
LABEL description="SmartFirePredict static dashboard served by Nginx"

# Remove the default Nginx HTML (we replace it with our dashboard)
RUN rm -rf /usr/share/nginx/html/*

# Copy the dashboard static assets
COPY frontend/dashboard/static/ /usr/share/nginx/html/static/
COPY frontend/dashboard/templates/index.html /usr/share/nginx/html/index.html

# Copy our custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
