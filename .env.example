# Environment Variables — fill these in before running

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Twilio Automated Calls
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15551234567     # Your Twilio phone number
TWILIO_TO_NUMBER=+15557654321       # Your personal number to receive calls
TWILIO_ON_SMOKE=false                # Set true to also call on smoke detections

# ESP32 Serial (leave blank for auto-detect)
ESP32_PORT=

# Stream Auto-Start (Docker / Deployment only)
# Leave blank when running locally — stream is started manually via the dashboard.
# Set this to your RTSP URL when running in Docker so the stream starts automatically.
# Example (MediaMTX on same Windows host):  rtsp://host.docker.internal:8554/webcam
DEFAULT_STREAM_URL=

# Demo Mode (disables real Telegram/Twilio alerts if true)
DEMO_MODE=true
